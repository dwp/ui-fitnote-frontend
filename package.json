{
  "name": "FitNote",
  "description": "Fit Note Front-end",
  "version": "3.4.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "postinstall": "npm run build",
    "build": "npm run build:scss && npm run build:hmrc && npm run build:js",
    "build:scss": "sass assets/hods.scss assets/hods.css --load-path=node_modules --no-source-map",
    "build:hmrc": "sass assets/hmrc.scss assets/hmrc.css --load-path=node_modules --no-source-map",
    "build:js": "rollup -c",
    "deps:update": "npm-check-updates -u && npm i",
    "dev": "NODE_ENV=dev DEBUG=casa* PORT=3000 npm run start",
    "prod": "NODE_ENV=prod node ./bin/server.js",
    "quality:coverage": "c8 node_modules/.bin/_mocha -- -- test/unit/**/**/*",
    "quality:lint:fix": "eslint --fix .",
    "quality:lint": "eslint .",
    "quality:stylelint": "stylelint \"assets/**/*.scss\" -f verbose",
    "start": "node ./bin/server.js",
    "test": "npm run test:unit",
    "test:unit": "mocha -- -- test/unit/**/**/*",
    "security:vulnerable-packages": "nsp check",
    "restart": "npm run build && npm run start"
  },
  "dependencies": {
    "@dwp/govuk-casa": "9.6.5",
    "@fastify/busboy": "3.2.0",
    "@ministryofjustice/frontend": "6.0.0",
    "config": "4.4.1",
    "connect-redis": "8.1.0",
    "esmock": "2.7.3",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "hmrc-frontend": "7.2.0",
    "filesize": "11.0.13",
    "home-office-kit": "1.2.0",
    "ioredis": "5.10.1",
    "pino": "10.3.1",
    "axios": "1.15.0",
    "valimate-notifier": "1.0.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@babel/eslint-parser": "7.28.6",
    "@babel/preset-env": "7.29.0",
    "@dwp/eslint-config-base": "9.0.2",
    "@dwp/eslint-config-mocha": "1.3.1",
    "@rollup/plugin-alias": "5.1.1",
    "@rollup/plugin-babel": "6.1.0",
    "@rollup/plugin-legacy": "3.0.2",
    "@rollup/plugin-node-resolve": "13.3.0",
    "c8": "10.1.3",
    "chai": "5.3.3",
    "chai-as-promised": "8.0.2",
    "eslint": "9.39.2",
    "mocha": "11.7.5",
    "npm-check-updates": "18.3.1",
    "rollup": "2.80.0",
    "sass": "1.97.3",
    "sinon": "21.0.1",
    "stylelint": "16.26.1",
    "stylelint-config-recommended": "17.0.0",
    "stylelint-scss": "6.14.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "form-data": "2.5.5",
    "tough-cookie": "4.1.4",
    "postcss-selector-parser": "7.1.1",
    "validator": "13.15.26",
    "qs": "6.15.0",
    "flat-cache": "6.1.20",
    "serialize-javascript":"7.0.3",
    "immutable":"5.1.5",
    "minimatch": "10.2.3",
    "flatted": "3.4.2"
  }
}
