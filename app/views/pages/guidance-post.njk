{% extends "layouts/main.njk" %}

{% block casaPageTitle %}
  {{ t('guidance-post:pageTitle') }}
{% endblock %}


{% block content %}
<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds govuk-body">
      <h1 class="govuk-heading-l govuk-!-padding-bottom-2">{{ t('guidance-post:h1') }}</h1>
      <p class="govuk-body">{{ t('guidance-post:p1') }}</p>
      <p class="govuk-body">{{ t('guidance-post:p2') }}</p>
      <div class="govuk-inset-text">
          {{ t('guidance-post:insetText') | safe }}
      </div>
      <p>{{ t('guidance-post:p3') }}</p>
    </div>
</div>
  {% include "partials/advisor.njk" %}
{% endblock %}

{% block footer %}
  {% include "partials/footer.njk" %}
{% endblock %}
